# typed: strict
# frozen_string_literal: true

# Homebrew formula for Windrose.
#
# Generated by scripts/update-formula.sh from windrose.rb.template — edit the
# template, not this file. The version and checksums are filled in from the
# published release, because a mistyped checksum breaks every install with an
# error that looks like a corrupted download.
class Windrose < Formula
  desc "Discover and assess every AI option on your Mac"
  homepage "https://github.com/jandro/windrose"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/jandro/windrose/releases/download/v@VERSION@/windrose-aarch64-apple-darwin.tar.xz"
      sha256 "@SHA_ARM@"
    end

    on_intel do
      url "https://github.com/jandro/windrose/releases/download/v@VERSION@/windrose-x86_64-apple-darwin.tar.xz"
      sha256 "@SHA_INTEL@"
    end
  end

  def install
    bin.install "windrose"
    # The reason this formula is maintained by hand: cargo-dist's generated
    # formula drops the man page into pkgshare, where `man` never looks.
    man1.install "windrose.1"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/windrose --version")
    # The gap this formula exists to close, guarded so it cannot reopen.
    assert_path_exists man1/"windrose.1"
  end
end
